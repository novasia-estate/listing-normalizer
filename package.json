{
  "name": "novasia-listing-normalizer",
  "version": "1.0.0",
  "description": "Multilingual property listing prices and land areas to explicit currency, square metres and price per m². Batch validation and JSON CLI; no FX guessing.",
  "license": "MIT",
  "author": "NovAsia Estate <contact@novasia.estate>",
  "homepage": "https://novasia.estate/",
  "repository": {"type": "git", "url": "git+https://github.com/novasia-estate/listing-normalizer.git"},
  "bugs": {"url": "https://github.com/novasia-estate/listing-normalizer/issues"},
  "keywords": ["real-estate", "proptech", "listing-data", "price-parser", "area-converter", "thai-land-units", "data-quality", "multilingual"],
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {".": {"types": "./index.d.ts", "import": "./index.mjs", "require": "./index.cjs"}},
  "bin": {"novasia-normalize": "cli.cjs"},
  "engines": {"node": ">=22"},
  "files": ["index.cjs", "index.mjs", "index.d.ts", "cli.cjs", "examples/listings.json", "README.md", "LICENSE"],
  "scripts": {"test": "node --test tests/*.test.cjs"},
  "publishConfig": {"access": "public"}
}
